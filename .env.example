# Local development only. Copy to .env and set independent random secrets.
PIC_MYSQL_PASSWORD=replace-with-random-database-password
PIC_MYSQL_ROOT_PASSWORD=replace-with-another-random-password
PIC_USERNAME=staff
PIC_PASSWORD=replace-with-store-password-at-least-12-bytes
# 工具访问密码由后端校验，不在前端代码中保存；至少 8 字节。
PIC_TOOL_PASSWORD=replace-with-tool-password
PIC_SESSION_KEY=replace-with-random-secret-at-least-32-bytes
PIC_ORIGIN=http://127.0.0.1:5173
# 可选：PicWish AI 抠图。配置密钥后启用 /api/v1/photos/cutout，留空返回 503。
PIC_PICWISH_API_KEY=
# 可选：上游地址覆盖（默认 https://techsz.aoscdn.com），仅供测试指向本地 mock。
PIC_PICWISH_API_URL=
# 可选：每日 AI 抠图调用上限（非负整数，留空或 0 不限制）。
PIC_PICWISH_DAILY_LIMIT=
